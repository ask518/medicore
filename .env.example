# MEDICORE Environment Configuration

# Deployment Mode: 'saas' (Multi-tenant shared) or 'enterprise' (Dedicated single-tenant)
VITE_DEPLOYMENT_PROFILE=saas
VITE_APP_NAME="MEDICORE Healthcare Platform"
VITE_DEFAULT_LOCALE=ar

# Supabase Managed Cloud Configuration (Get from Supabase project settings -> API)
# Required for authentication and all live patient/clinic data. The app has no offline demo store.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enterprise Customization (Used if VITE_DEPLOYMENT_PROFILE=enterprise)
VITE_ENTERPRISE_ORG_NAME=
VITE_ENTERPRISE_PRIMARY_COLOR="#0c87eb"
VITE_ENTERPRISE_LOGO_URL="/favicon.svg"

# Optional Cloud Integrations (Documented & Safe)
VITE_ENABLE_AI_ASSISTANT=false
VITE_CURRENCY_CODE="EGP"
VITE_CURRENCY_SYMBOL="ج.م"
